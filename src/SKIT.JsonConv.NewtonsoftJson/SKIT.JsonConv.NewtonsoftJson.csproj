<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0; net6.0; net8.0; net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>SKIT.JsonConv.NewtonsoftJson</PackageId>
        <PackageVersion>0.1.1</PackageVersion>
        <PackageIcon>LOGO.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.JsonConv</PackageProjectUrl>
        <PackageTags>SKIT; JSON; JSON Converter; Newtonsoft.Json</PackageTags>
        <Authors>Fu Diwei</Authors>
        <Description>为 Newtonsoft.Json 扩展更多的 JSON 转换器。</Description>
    </PropertyGroup>

	<ItemGroup>
		<None Include="../../LOGO.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<Import Project="..\SKIT.JsonConv.Shared\SKIT.JsonConv.Shared.projitems" Label="Shared" />
</Project>
